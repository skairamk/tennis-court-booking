DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT=3001

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-random-secret

# The public URL this app is served from. In dev this is the Express
# server's own port; in production set it to your deployed HTTPS URL.
BETTER_AUTH_URL=http://localhost:3001
